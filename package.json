{
  "name": "acervus-finance-pwa",
  "version": "0.1.0",
  "description": "Acervus Finance PWA: lending portfolio manager (Vite + React + Convex + Better Auth)",
  "scripts": {
    "dev": "vite",
    "dev:backend": "convex dev",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p convex --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:frontend": "wrangler deploy",
    "deploy:backend": "convex deploy --cmd \"npm run build\" --cmd-url-env-var-name VITE_CONVEX_URL",
    "smoke:local": "node scripts/smoke-auth.mjs",
    "screenshots:local": "node scripts/screenshots.mjs"
  },
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@convex-dev/better-auth": "0.12.6",
    "better-auth": "1.6.33",
    "convex": "1.48.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "convex-test": "0.0.66",
    "fake-indexeddb": "6.2.6",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "4.1.12",
    "wrangler": "4.154.0"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
