# Front-end variables (Vite). Everything starting with VITE_ is PUBLIC: it is
# built into the JavaScript that every visitor downloads. Never put a secret
# here. `npx convex dev` writes the first two to .env.local for development.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Server-only variables live on the Convex deployment, never in this file:
#   npx convex env set BETTER_AUTH_SECRET <random 32+ bytes>
#   npx convex env set SITE_URL https://your-app.example.com
#   npx convex env set RESEND_API_KEY re_...            (email)
#   npx convex env set EMAIL_FROM "Acervus Finance <no-reply@your-domain>"
#   npx convex env set GOOGLE_CLIENT_ID ...              (optional)
#   npx convex env set GOOGLE_CLIENT_SECRET ...          (optional)
# See docs/DEPLOYMENT.md.
