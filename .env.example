# A template only. Your real file is .env.local, which `npx convex dev` writes
# for you. Don't copy this file by hand. docs/DEPLOYMENT.md (part 1) explains
# every line and how to check it points at the right deployment.
#
# Everything starting with VITE_ is PUBLIC: it is built into the JavaScript
# that every visitor downloads. Never put a secret here.
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# Server-only variables live in the Convex dashboard (Settings > Environment
# Variables), separately for Development and Production, never in this file:
#   BETTER_AUTH_SECRET, SITE_URL, RESEND_API_KEY, EMAIL_FROM,
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (optional)
#
# Deploy keys live in GitHub (Settings > Secrets and variables > Actions):
#   CONVEX_DEPLOY_KEY, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID
